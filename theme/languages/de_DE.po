# German strings of the ai-elem-child theme (front end of the blog widgets).
# Compile: npm run wp:cli -- i18n make-mo wp-content/themes/ai-elem-child/languages (and make-php). The file
# is named after the locale only (de_DE.po): that is what load_child_theme_textdomain() looks for.
msgid ""
msgstr ""
"Project-Id-Version: ai-elem-child\n"
"Language: de_DE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: ai-elem-child\n"

msgid "Pagination"
msgstr "Seitennavigation"

#. translators: 1: first article on the page, 2: last article on the page, 3: number of articles.
msgid "%1$s to %2$s of %3$s"
msgstr "%1$s bis %2$s von %3$s"

msgid "First page"
msgstr "Erste Seite"

msgid "Previous page"
msgstr "Vorherige Seite"

#. translators: 1: current page, 2: number of pages.
msgid "Page %1$s of %2$s"
msgstr "Seite %1$s von %2$s"

msgid "Next page"
msgstr "Nächste Seite"

msgid "Last page"
msgstr "Letzte Seite"

msgid "Search articles"
msgstr "Artikel durchsuchen"

msgid "Search"
msgstr "Suchen"

#. translators: %s: search words.
msgid "Search results for “%s”"
msgstr "Suchergebnisse für „%s“"

msgid "No articles match your search. Try other words or browse the categories."
msgstr "Keine Artikel gefunden. Versuchen Sie andere Suchbegriffe oder stöbern Sie in den Kategorien."
